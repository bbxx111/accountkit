# Copy to an ignored .env file and fill the required credentials below.
# Database password: generate URL-safe hex (for example openssl rand -hex 24).
# SUBJECT_HMAC_KEY / SUBJECT_CIPHER_KEY: separately run openssl rand -base64 32.
# JWT_KEY is an ES256 (P-256) private key as base64 PKCS#8 DER, for example:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# Its public key is served at /.well-known/jwks.json for local verification by business services.
POSTGRES_PASSWORD=
JWT_KEY=
SUBJECT_HMAC_KEY=
SUBJECT_CIPHER_KEY=
# JSON, for example {"business-service":["<separately-generated-base64-secret>"]}
ACCOUNTSVC_INTROSPECTION_CLIENTS=
ACCOUNTSVC_PUBLIC_PORT=18080
# Local Compose explicitly selects HTTP. The service itself keeps its original
# defaults when unset/empty: production requires TLS; development without certificates uses HTTP.
# true requires valid ACCOUNTSVC_TLS_CERT_FILE/ACCOUNTSVC_TLS_KEY_FILE files mounted in the container.
# false conflicts with either HTTP certificate setting and is rejected by serve.
# This template has no certificate mounts; configure those separately before selecting true.
ACCOUNTSVC_TLS_ENABLED=false
# Optional Prometheus endpoint on the same listener; restrict gateway and direct sources first.
ACCOUNTSVC_METRICS_ENABLED=false
# Required only when enabled: fixed non-secret label matching [A-Za-z0-9][A-Za-z0-9._-]{0,63}.
# Different logical account instances need different values; replicas use scrape target labels.
ACCOUNTSVC_METRICS_INSTANCE=
MAILPIT_HTTP_PORT=18025
# Optional profile attributes: set the container path in a Compose override and
# mount the reviewed JSON Schema read-only; see docs/accountsvc.md.
# All declared profile attributes become readable and writable by their owner.
# ACCOUNTSVC_PROFILE_ATTRIBUTES_SCHEMA_FILE=/etc/accountsvc/profile-schema.json
# Compose explicitly enables EMAIL and requires EMAIL, matching the Mailpit sender.
# For an IdP-only host, explicitly select a configured provider and set Required as [].
# Existing accounts backfill empty display name / avatar from provider claims on sign-in,
# binding and completion linking. New accounts are always filled. Default true.
# ACCOUNTKIT_PROVIDER_PROFILE_BACKFILL=true
# Explicit GOOGLE also needs ACCOUNTKIT_GOOGLE_CLIENT_IDS. There is no Google client secret.
# Facebook sign-in is enabled by setting an App ID; the App Secret must come from a secret store.
# Explicit FACEBOOK also needs both values. accountsvc has no data-deletion callback route.
# ACCOUNTKIT_FACEBOOK_APP_ID=
# ACCOUNTKIT_FACEBOOK_APP_SECRET=
# Configured OIDC kinds: list them in ACCOUNTKIT_OIDC_PROVIDERS, then set per kind
# ISSUER, JWKS_URL and CLIENT_IDS (NONCE_TTL, NAME_CLAIMS, PICTURE_CLAIMS optional;
# an empty *_CLAIMS value disables that claim). Kind names must not be builtin names.
# ACCOUNTKIT_OIDC_PROVIDERS=CORP_SSO
# ACCOUNTKIT_OIDC_CORP_SSO_ISSUER=https://sso.example.test
# ACCOUNTKIT_OIDC_CORP_SSO_JWKS_URL=https://sso.example.test/jwks
# ACCOUNTKIT_OIDC_CORP_SSO_CLIENT_IDS=example-client
# Explicit PHONE requires an embedded host with a real SMS sender.

# WeChat OAuth apps and mini programs use separate appid:secret lists.
# AppIDs must be unique across both lists; secrets may contain colons.
# ACCOUNTKIT_WECHAT_APPS=oauth-app:replace-with-secret
# ACCOUNTKIT_WECHAT_MINI_PROGRAM_APPS=mini-app:replace-with-secret
# Omit mode for UNIONID. If set, only UNIONID or OPENID is accepted; empty is invalid.
# Keep the mode fixed and identical across replicas. Prefix subjects do not match legacy bare UnionIDs.
# ACCOUNTKIT_WECHAT_SUBJECT_MODE=UNIONID

# Alipay App minimal SDK: ordinary public-key mode, RSA >=2048 bits, not certificates.
# Synthetic AppIDs below are examples only; keys must be injected from a secret store.
# Each PRIVATE_KEY is the application's PEM private key; PUBLIC_KEY is Alipay's PEM public key.
# PEM must contain real newlines; literal \n and file paths are not expanded by the library.
# ACCOUNTKIT_ALIPAY_APP_IDS=2026000000000001,2026000000000002
# ACCOUNTKIT_ALIPAY_2026000000000001_PRIVATE_KEY=
# ACCOUNTKIT_ALIPAY_2026000000000001_PUBLIC_KEY=
# ACCOUNTKIT_ALIPAY_2026000000000002_PRIVATE_KEY=
# ACCOUNTKIT_ALIPAY_2026000000000002_PUBLIC_KEY=
# ACCOUNTKIT_ALIPAY_SUBJECT_MODE=UNIONID
# ACCOUNTKIT_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# Pure Alipay: explicitly pass ENABLED_IDENTITY_KINDS=ALIPAY and REQUIRED_IDENTITY_KINDS=[].
# This Compose defaults to EMAIL and does not forward arbitrary .env variables.
# Use a Compose override/deployment environment to pass every ALIPAY_* variable and override E/R.
# Keep mode/trust identical across replicas; validate application grouping on real apps.
# The client owns auth_user, one-time state and SDK return handling. No authInfo/callback endpoint.
# See docs/alipay-sign-in.md; real App/application-group verification is still required.

# QQ App SDK sign-in (no AppKey required)
# ACCOUNTKIT_QQ_APP_IDS=1100000001,1100000002
# ACCOUNTKIT_QQ_SUBJECT_MODE=UNIONID
# ACCOUNTKIT_QQ_API_BASE_URL=https://graph.qq.com
# Pure QQ: explicitly pass ENABLED_IDENTITY_KINDS=QQ and REQUIRED_IDENTITY_KINDS=[].

# Aliyun SMS (mainland China numbers only). Set the provider and all values below,
# then add PHONE to ACCOUNTKIT_ENABLED_IDENTITY_KINDS explicitly. The secret must come
# from a secret store. Templates use the single variable ${code}.
# ACCOUNTSVC_SMS_PROVIDER=aliyun
# ACCOUNTSVC_SMS_ALIYUN_ACCESS_KEY_ID=
# ACCOUNTSVC_SMS_ALIYUN_ACCESS_KEY_SECRET=
# ACCOUNTSVC_SMS_ALIYUN_SIGN_NAME=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_SIGN_IN=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_BIND=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_REAUTH=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_SIGN_IN_COMPLETE=
# Optional brand prefix for built-in Chinese verification emails (1-32 chars, no control characters).
# ACCOUNTSVC_SMTP_BRAND=

# Weibo App SDK sign-in (APP_IDS are Weibo AppKeys; no AppSecret required)
# ACCOUNTKIT_WEIBO_APP_IDS=1234567890,1234567891
# ACCOUNTKIT_WEIBO_API_BASE_URL=https://api.weibo.com
# Pure Weibo: explicitly pass ENABLED_IDENTITY_KINDS=WEIBO and REQUIRED_IDENTITY_KINDS=[].
