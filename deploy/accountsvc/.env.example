# Copy to an ignored .env file and fill the required credentials below.
# Database password: generate URL-safe hex (for example openssl rand -hex 24).
# SUBJECT_HMAC_KEY / SUBJECT_CIPHER_KEY: separately run openssl rand -base64 32.
# JWT_KEY is an ES256 (P-256) private key as base64 PKCS#8 DER, for example:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# Its public key is served at /.well-known/jwks.json for local verification by business services.
POSTGRES_PASSWORD=
JWT_KEY=
SUBJECT_HMAC_KEY=
SUBJECT_CIPHER_KEY=
# Service clients: choose ONE complete example below, uncomment it and replace secrets.
# Use compose.yaml with --env-file deploy/accountsvc/.env; its env_file loads the same file.
# Unset, empty or whitespace-only SERVICE_CLIENTS all produce an empty registry:
# serve starts normally; introspection and the purged-user feed each return NOT_CONFIGURED 503.
# Leave every SERVICE_CLIENT_<ALIAS>_* field and issuer/audience absent when no client is declared.
# Old per-interface *_BASIC_CLIENTS / *_BEARER_CLIENTS settings have been removed.
# Any nonblank old value, including {} or [], fails startup; migrate clients and permissions explicitly.
# Aliases are uppercase configuration labels; ID is the Basic username / verified Bearer azp.
# Only basic,bearer and tokens.introspect,purged_users.read are supported (case-sensitive).
# Every Basic secret: separately run openssl rand -base64 32; use the base64 TEXT as the password.
# Basic secrets are NOT IdP client secrets. Never reuse secrets between different client IDs.
# Production calls require certificate-verified TLS; this Compose is local development only.

# Basic-only, introspection only; no issuer/audience and no provider dependency.
# BEGIN SERVICE CLIENT EXAMPLE BASIC_ONLY
# ACCOUNTSVC_SERVICE_CLIENTS=BUSINESS
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_ID=business-service
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_AUTH_METHODS=basic
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_PERMISSIONS=tokens.introspect
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_BASIC_SECRETS=<basic-secret-old>
# END SERVICE CLIENT EXAMPLE BASIC_ONLY

# Bearer-only, introspection only; the caller obtains client_credentials tokens from its IdP.
# The IdP client secret belongs only to the caller and IdP; do not put it in BASIC_SECRETS.
# BEGIN SERVICE CLIENT EXAMPLE BEARER_ONLY
# ACCOUNTSVC_SERVICE_CLIENTS=BUSINESS
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_ID=business-service
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_AUTH_METHODS=bearer
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_PERMISSIONS=tokens.introspect
# ACCOUNTSVC_SERVICE_ISSUER=https://sso.example.test/realms/services
# ACCOUNTSVC_SERVICE_AUDIENCE=accountsvc-internal
# END SERVICE CLIENT EXAMPLE BEARER_ONLY

# Both methods and both permissions, only for a service that needs both capabilities.
# Overlapping Basic rotation: restart all replicas with old,new; update callers; remove old and restart.
# BEGIN SERVICE CLIENT EXAMPLE BOTH_ROTATION
# ACCOUNTSVC_SERVICE_CLIENTS=BUSINESS
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_ID=business-service
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_AUTH_METHODS=basic,bearer
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_PERMISSIONS=tokens.introspect,purged_users.read
# ACCOUNTSVC_SERVICE_CLIENT_BUSINESS_BASIC_SECRETS=<basic-secret-old>,<basic-secret-new>
# ACCOUNTSVC_SERVICE_ISSUER=https://sso.example.test/realms/services
# ACCOUNTSVC_SERVICE_AUDIENCE=accountsvc-internal
# END SERVICE CLIENT EXAMPLE BOTH_ROTATION
# Multiple clients: list aliases in SERVICE_CLIENTS and supply all fields for each alias.
# Unknown fields, undeclared aliases, duplicate IDs/secrets and empty list elements are rejected.
# Configuration is a startup snapshot. Restart/drain every old replica before declaring revocation effective.
# Disabling a client at the IdP does not immediately invalidate already issued access tokens.
ACCOUNTSVC_PUBLIC_PORT=18080
# Local Compose explicitly selects HTTP. The service itself keeps its original
# defaults when unset/empty: production requires TLS; development without certificates uses HTTP.
# true requires valid ACCOUNTSVC_TLS_CERT_FILE/ACCOUNTSVC_TLS_KEY_FILE files mounted in the container.
# false conflicts with either HTTP certificate setting and is rejected by serve.
# This template has no certificate mounts; configure those separately before selecting true.
ACCOUNTSVC_TLS_ENABLED=false
# Optional Prometheus endpoint on the same listener; restrict gateway and direct sources first.
ACCOUNTSVC_METRICS_ENABLED=false
# Required only when enabled: fixed non-secret label matching [A-Za-z0-9][A-Za-z0-9._-]{0,63}.
# Different logical account instances need different values; replicas use scrape target labels.
ACCOUNTSVC_METRICS_INSTANCE=
MAILPIT_HTTP_PORT=18025
# Optional profile attributes: set the container path in a Compose override and
# mount the reviewed JSON Schema read-only; see docs/accountsvc.md.
# All declared profile attributes become readable and writable by their owner.
# ACCOUNTSVC_PROFILE_ATTRIBUTES_SCHEMA_FILE=/etc/accountsvc/profile-schema.json
# Compose explicitly enables EMAIL and requires EMAIL, matching the Mailpit sender.
# For an IdP-only host, explicitly select a configured provider and set Required as [].
# Existing accounts backfill empty display name / avatar from provider claims on sign-in,
# binding and completion linking. New accounts are always filled. Default true.
# ACCOUNTSVC_PROVIDER_PROFILE_BACKFILL=true
# Explicit GOOGLE also needs ACCOUNTSVC_GOOGLE_CLIENT_IDS. There is no Google client secret.
# Facebook sign-in is enabled by setting an App ID; the App Secret must come from a secret store.
# Explicit FACEBOOK also needs both values. accountsvc has no data-deletion callback route.
# ACCOUNTSVC_FACEBOOK_APP_ID=
# ACCOUNTSVC_FACEBOOK_APP_SECRET=
# Configured OIDC kinds: list them in ACCOUNTSVC_OIDC_PROVIDERS, then set per kind
# ISSUER, JWKS_URL and CLIENT_IDS (NONCE_TTL, NAME_CLAIMS, PICTURE_CLAIMS optional;
# an empty *_CLAIMS value disables that claim). Kind names must not be builtin names.
# ACCOUNTSVC_OIDC_PROVIDERS=CORP_SSO
# ACCOUNTSVC_OIDC_CORP_SSO_ISSUER=https://sso.example.test
# ACCOUNTSVC_OIDC_CORP_SSO_JWKS_URL=https://sso.example.test/jwks
# ACCOUNTSVC_OIDC_CORP_SSO_CLIENT_IDS=example-client
# Explicit PHONE requires an embedded host with a real SMS sender.

# WeChat OAuth apps and mini programs use separate appid:secret lists.
# AppIDs must be unique across both lists; secrets may contain colons.
# ACCOUNTSVC_WECHAT_APPS=oauth-app:replace-with-secret
# ACCOUNTSVC_WECHAT_MINI_PROGRAM_APPS=mini-app:replace-with-secret
# Omit mode for UNIONID. If set, only UNIONID or OPENID is accepted; empty is invalid.
# Keep the mode fixed and identical across replicas. Prefix subjects do not match legacy bare UnionIDs.
# ACCOUNTSVC_WECHAT_SUBJECT_MODE=UNIONID

# Alipay App minimal SDK: ordinary public-key mode, RSA >=2048 bits, not certificates.
# Synthetic AppIDs below are examples only; keys must be injected from a secret store.
# Each PRIVATE_KEY is the application's PEM private key; PUBLIC_KEY is Alipay's PEM public key.
# PEM must contain real newlines; literal \n and file paths are not expanded by the library.
# ACCOUNTSVC_ALIPAY_APP_IDS=2026000000000001,2026000000000002
# ACCOUNTSVC_ALIPAY_2026000000000001_PRIVATE_KEY=
# ACCOUNTSVC_ALIPAY_2026000000000001_PUBLIC_KEY=
# ACCOUNTSVC_ALIPAY_2026000000000002_PRIVATE_KEY=
# ACCOUNTSVC_ALIPAY_2026000000000002_PUBLIC_KEY=
# ACCOUNTSVC_ALIPAY_SUBJECT_MODE=UNIONID
# ACCOUNTSVC_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
# Pure Alipay: explicitly pass ENABLED_IDENTITY_KINDS=ALIPAY and REQUIRED_IDENTITY_KINDS=[].
# Base Compose loads all .env variables and defaults to EMAIL; override E/R explicitly for pure Alipay.
# Keep mode/trust identical across replicas; validate application grouping on real apps.
# The client owns auth_user, one-time state and SDK return handling. No authInfo/callback endpoint.
# See docs/alipay-sign-in.md; real App/application-group verification is still required.

# QQ App SDK sign-in (no AppKey required)
# ACCOUNTSVC_QQ_APP_IDS=1100000001,1100000002
# ACCOUNTSVC_QQ_SUBJECT_MODE=UNIONID
# ACCOUNTSVC_QQ_API_BASE_URL=https://graph.qq.com
# Pure QQ: explicitly pass ENABLED_IDENTITY_KINDS=QQ and REQUIRED_IDENTITY_KINDS=[].

# Aliyun SMS (mainland China mobile numbers only). Set the provider and all values below,
# then enable PHONE explicitly, e.g. ACCOUNTSVC_ENABLED_IDENTITY_KINDS=PHONE,EMAIL and
# ACCOUNTSVC_REQUIRED_IDENTITY_KINDS=PHONE,EMAIL (Compose defaults both to EMAIL).
# The secret must come from a secret store. Templates use the single variable ${code}.
# ACCOUNTSVC_ENABLED_IDENTITY_KINDS=EMAIL
# ACCOUNTSVC_REQUIRED_IDENTITY_KINDS=EMAIL
# ACCOUNTSVC_SMS_PROVIDER=aliyun
# ACCOUNTSVC_SMS_ALIYUN_ACCESS_KEY_ID=
# ACCOUNTSVC_SMS_ALIYUN_ACCESS_KEY_SECRET=
# ACCOUNTSVC_SMS_ALIYUN_SIGN_NAME=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_SIGN_IN=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_BIND=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_REAUTH=
# ACCOUNTSVC_SMS_ALIYUN_TEMPLATE_SIGN_IN_COMPLETE=
# Optional email template manifest (local JSON, max 64 KiB, read once at startup): per-language
# wording, brand and logo URL rendered with the built-in layout as HTML + plain text, language chosen
# from the request's Accept-Language. Unset uses the embedded brandless default wording and logs a
# WARN. Mount it read-only; start from deploy/accountsvc/email-templates.example.json and validate
# with `accountsvc email-templates check <file> -out <dir>`. See docs/accountsvc.md#邮件模板清单.
# ACCOUNTSVC_SMTP_TEMPLATES_FILE=/etc/accountsvc/email-templates.json

# Weibo App SDK sign-in (APP_IDS are Weibo AppKeys; no AppSecret required)
# ACCOUNTSVC_WEIBO_APP_IDS=1234567890,1234567891
# ACCOUNTSVC_WEIBO_API_BASE_URL=https://api.weibo.com
# Pure Weibo: explicitly pass ENABLED_IDENTITY_KINDS=WEIBO and REQUIRED_IDENTITY_KINDS=[].
