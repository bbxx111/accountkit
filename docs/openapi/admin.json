{
  "openapi": "3.1.0",
  "info": {
    "title": "accountkit 管理 HTTP API",
    "version": "v0.7.2",
    "description": "v0.7.2 的内置管理 HTTP 契约，操作与字段与 v0.7.1 相同（v0.7.1 与 v0.7.0 相同，同 v0.6.0），adminRevealIdentity 的 200 响应声明 Cache-Control: no-store；身份类型字符串可包含 v0.6.0 新增的内置及配置提供方类型。用户资源的 avatar_url 自 v0.5.0 起提供。宿主配置实际挂载地址。请求体为单个 JSON 对象，默认上限 64 KiB，拒绝未知字段与尾随内容。领域状态、事务、故障策略以规格与 README 为准。"
  },
  "servers": [
    {
      "url": "{basePath}",
      "description": "basePath 是宿主实际挂载前缀，可改为完整服务 URL。",
      "variables": {
        "basePath": {
          "default": "/admin/v1"
        }
      }
    }
  ],
  "security": [
    {
      "AdminBearer": []
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "operationId": "adminListUsers",
        "summary": "筛选与分页列出账号",
        "description": "按 create_time、id 的 keyset 分页。filter 使用 AND 子集，无 OR/NOT/括号。身份条件必须同一 kind 且命中同一活跃身份；具体支持字段见 docs/openapi.md。 所需管理员角色：operator；角色层级由宿主 verifier 决定。",
        "responses": {
          "200": {
            "description": "成功。",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestID"
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "省略或 0 使用 20；大于 100 时截为 100；负数或非整数返回 400。",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 20
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "description": "不透明游标；省略或空字符串从第一页开始。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "show_deleted",
            "in": "query",
            "description": "true 才包含 PENDING_DELETION / DELETED。",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "x-required-role": "operator",
        "x-error-reasons": {
          "400": [
            "INVALID_FILTER",
            "INVALID_PAGE_SIZE",
            "INVALID_PAGE_TOKEN",
            "INVALID_SHOW_DELETED"
          ],
          "401": [
            "TOKEN_MISSING"
          ],
          "503": [
            "ADMIN_NOT_CONFIGURED"
          ]
        }
      }
    },
