  "x-error-reason-catalog": {
    "ADMIN_NOT_CONFIGURED": "宿主未注入 AdminVerifier/AdminPrincipal，管理面整体不可用（503 UNAVAILABLE）。",
    "AUDIT_QUERY_NOT_CONFIGURED": "宿主只注入了审计写侧、未注入 Reader，审计查询不可用（503）。",
    "AUDIT_QUERY_UNAVAILABLE": "审计 Reader 返回错误、超出页限、记录非法、顺序错乱、越出账号范围或无法投影为认证事件（503，不伪装成空列表）。",
    "DELETION_BLOCKED": "宿主 BeforeDelete 回调返回 user.ErrDeletionBlocked，拒绝注销（400 FAILED_PRECONDITION）。",
    "INVALID_ACCOUNT_STATE": "账号当前状态不允许该状态迁移或写入（如非 ACTIVE 更新资料、非 PENDING_DELETION 恢复、已 purge）（400 FAILED_PRECONDITION）。",
    "INVALID_ARGUMENT": "通用参数错误：kind 格式非法、code_id 非 32 位小写十六进制、display_name/avatar_url/reason 非法、设备字段超长、换绑身份类型不匹配等；message 携带具体说明。",
    "INVALID_FILTER": "管理面 filter 语法/字段/运算符不受支持，或 identity.phone/identity.email 值无法归一化。",
    "INVALID_ID": "路径中的资源 ID（u_/i_/s_ + 13 位 Crockford base32）格式非法。",
    "INVALID_PAGE_SIZE": "page_size 不是非负整数。",
    "INVALID_PAGE_TOKEN": "page_token 无法解析、字段缺失，或审计游标版本/source/资源/动作集合不匹配；应从第一页重新开始。",
    "INVALID_SHOW_DELETED": "show_deleted 不是 true/false。",
    "MALFORMED_BODY": "请求体缺失、非法 JSON、顶层非对象、含未知字段、超过大小上限或有尾随内容；updateMe 的 avatar_url 非字符串/null 亦归此类。",
    "NOT_FOUND": "资源不存在、已解绑/已吊销，或不属于该用户/账号（404；不暴露存在性）。",
    "TOKEN_MISSING": "Authorization 头缺失或不是合法的 Bearer 形式（401，WWW-Authenticate: Bearer realm=\"user\"）；管理面表示宿主 verifier 未在 ctx 注入 Principal（realm=\"admin\"）。",
    "USER_FROZEN": "账号被管理端冻结。C 端为 403 PERMISSION_DENIED；管理面为 400 FAILED_PRECONDITION（需先解冻）。"
  }
}
