      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 400,
                "maximum": 599
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "INVALID_ARGUMENT",
                  "FAILED_PRECONDITION",
                  "UNAUTHENTICATED",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "RESOURCE_EXHAUSTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "ALREADY_EXISTS"
                ]
              },
              "reason": {
                "type": "string",
                "description": "稳定的机器可读错误原因（UPPER_SNAKE_CASE）。每个操作可能出现的值列在该操作的 x-error-reasons（按 HTTP 状态分组），完整说明见本文件 x-error-reason-catalog；客户端按 reason 分支，message 仅供人读且可能变化。部分响应不带 reason，只能按 code/status 处理。"
              },
              "retry_after_seconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "code",
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
