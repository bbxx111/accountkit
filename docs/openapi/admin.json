        "type": "http",
        "scheme": "bearer",
        "description": "独立管理员身份凭证。宿主验证 issuer/audience/签名并注入角色与主体，不接受消费者令牌代替。宿主采用不同认证协议时须适配此定义。"
      }
    },
    "parameters": {
      "RequestID": {
        "name": "X-Request-Id",
        "in": "header",
        "required": false,
        "description": "默认接受 1–64 位字母、数字、点、下划线、连字符，缺失或非法时生成；宿主可覆盖关联 ID 策略。",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error400": {
        "description": "输入、轮次或前置条件不满足。FAILED_PRECONDITION 映射为 400。通用 reason：INVALID_ID、MALFORMED_BODY；操作特有 reason 见各操作的 x-error-reasons。",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Error401": {
        "description": "宿主管理员认证/角色校验拒绝；错误体与 challenge 由宿主 verifier 定义。库内缺失管理员主体时返回 ApiError。通用 reason：TOKEN_MISSING；操作特有 reason 见各操作的 x-error-reasons。"
      },
      "Error403": {
        "description": "宿主管理员认证/角色校验拒绝；错误体与 challenge 由宿主 verifier 定义。库内缺失管理员主体时返回 ApiError。"
      },
      "Error404": {
        "description": "资源不存在或不属于当前用户；不暴露其他账号资源。",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Error409": {
        "description": "身份占用或同类身份数量限制。",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Error429": {
        "description": "发送/验证预算耗尽；retry_after_seconds 与 Retry-After 指定等待秒数。",
        "headers": {
          "Retry-After": {
            "description": "存在时为等待秒数。",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Error500": {
        "description": "固定 internal error，不暴露内部诊断。",
        "headers": {},
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Error503": {
        "description": "依赖或可选能力未配置/不可用；不降级绕过验证。通用 reason：ADMIN_NOT_CONFIGURED；操作特有 reason 见各操作的 x-error-reasons。",
        "headers": {
          "Retry-After": {
            "description": "存在时为等待秒数。",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "UserID": {
        "type": "string",
        "pattern": "^u_[0-9a-hjkmnp-tv-z]{13}$"
      },
      "IdentityID": {
