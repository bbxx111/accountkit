    "/users/{user}/auditEvents": {
      "get": {
        "operationId": "adminListAuditEvents",
        "summary": "读取账号认证审计",
        "description": "仅返回当前账号范围的认证事件，不透传通用业务 data。按 occur_time、UUID 升序；v2 游标绑定来源、账号和认证动作集合，旧游标返回 400 INVALID_PAGE_TOKEN，须从第一页重新开始。仅外部写侧为 503 AUDIT_QUERY_NOT_CONFIGURED；读侧故障/越界为 503 AUDIT_QUERY_UNAVAILABLE。 所需管理员角色：operator；角色层级由宿主 verifier 决定。",
        "responses": {
          "200": {
