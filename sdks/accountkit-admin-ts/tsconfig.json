{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "isolatedModules": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true
  },
  "include": ["src", "test"]
}
